# Only shared content and repository maintenance files belong at the root
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/global/
!/skills/
!/THIRD_PARTY_NOTICES.md
!/LICENSES/

# Secrets and local overrides
.env
.env.*
!.env.example
!.env.sample
**/secrets/
**/credentials/
*.key
*.pem

# Generated and runtime files
**/node_modules/
**/.cache/
**/*.log
**/*.pid
**/*.sock

# Editor, OS, and backup files
.DS_Store
Thumbs.db
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.backup
