{
    "$schema": "https://opencode.ai/config.json",
    // 默认主模型。字段名必须是 `model`（单数），不是 `models`。
    // 实际可用模型以 opencode 内的 `/models` 列表为准。
    "model": "openai/gpt-5.6-sol",
    // 轻量模型：用于标题生成，避免占用主 Codex 模型额度。
    "agents": {
        "title": {
            "model": "openai/gpt-5.4-mini-fast"
        }
    },
    // 长会话省 token：自动压缩上下文。
    // 最近上下文采用 v2 默认 keep.tokens 预算，不按轮数保留。
    "compaction": {
        "auto": true,
        "buffer": 10000
    },
    "providers": {
        "openai": {
            // OpenAI/Codex 订阅模型的全局覆盖项。
            // OpenAI provider 使用 reasoningEffort/textVerbosity；不要混用 OpenRouter 的 provider.allow_fallbacks。
            "name": "openai",
            "models": {
                "gpt-5.5": {
                    "modelID": "gpt-5.5",
                    "settings": {
                        "reasoningEffort": "low",
                        "textVerbosity": "low"
                    },
                    "body": {
                        "temperature": 0.2
                    }
                }
            }
        }
    },
    "permissions": [
        { "action": "skill", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/projects/shared-libs/**", "effect": "ask" }
    ],
    "mcp": {
        "servers": {
            "agent-browser": {
                "type": "local",
                "command": [
                    "agent-browser",
                    "mcp"
                ],
                "disabled": false
            },
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "disabled": false
            },
            "grafana": {
                "type": "local",
                "command": [
                    "uvx",
                    "mcp-grafana",
                    "--disable-write"
                ],
                "disabled": false,
                "environment": {
                    "GRAFANA_URL": "{env:GRAFANA_URL}",
                    "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
                }
            },
            "filesystem": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@modelcontextprotocol/server-filesystem"
                ],
                "disabled": false
            }
        }
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "*.lock",
            "**/*.log",
            ".cache/**",
            "build/**",
            "__pycache__/**",
            ".venv/**",
            "venv/**"
        ]
    },
    "plugins": []
}
