{
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000,
        "tail_turns": 2
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "*.lock",
            "**/*.log",
            ".cache/**",
            "build/**",
            "__pycache__/**",
            ".venv/**",
            "venv/**"
        ]
    }
}
