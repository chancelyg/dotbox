{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "monokai"
  },
  "plugins": [],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  },
  "animations": true,
  "keybinds": {
    "session.tab.previous": "ctrl+left,<leader>left,ctrl+shift+tab,alt+up,shift+up",
    "session.tab.next": "ctrl+right,<leader>right,ctrl+tab,alt+down,shift+down",
    "input.select.up": "none",
    "input.select.down": "none",
    "input.word.backward": "alt+b,alt+left",
    "input.word.forward": "alt+f,alt+right"
  }
}
